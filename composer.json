{
    "name": "structuraphp/structura",
    "description": "Architectural testing for PHP",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "StructuraPhp\\Structura\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StructuraPhp\\Structura\\Benchmarks\\": "benchmarks",
            "StructuraPhp\\Structura\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "nikic/php-parser": "^5.4",
        "phpstan/phpdoc-parser": "^2.3",
        "psr/event-dispatcher": "^1.0",
        "symfony/console": "^7.2|^8.0",
        "symfony/event-dispatcher": "^7.2|^8.1",
        "symfony/event-dispatcher-contracts": "^3.7",
        "symfony/filesystem": "^7.2|^8.0",
        "symfony/finder": "^7.2|^8.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "friendsofphp/php-cs-fixer": "^3.94",
        "infection/infection": "^0.32",
        "phpbench/phpbench": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5|^12.5|^13.0",
        "rector/rector": "^2.3",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "infection/extension-installer": true
        }
    },
    "bin": [
        "bin/structura"
    ]
}
